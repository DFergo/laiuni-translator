# latest (follows main) or sha-<commit> to pin a version
BACKEND_TAG=latest
# Where the admin panel and the machine API listen: 127.0.0.1, or this machine's LAN / Tailscale IP
ADMIN_BIND=127.0.0.1
BACKEND_ADMIN_PORT=8000
# openssl rand -hex 32 — give the same value to every frontend as TRANSLATOR_BACKEND_SECRET
TRANSLATOR_FRONTEND_SECRET=
