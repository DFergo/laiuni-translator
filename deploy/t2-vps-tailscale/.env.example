# latest (follows main) or sha-<commit> to pin a version
FRONTEND_TAG=latest
# This VPS's Tailscale IPv4 (tailscale ip -4)
TAILSCALE_IP=
FRONTEND_BACKEND_PORT=8081
# The backend's TRANSLATOR_FRONTEND_SECRET (installation secret) or this frontend's own secret
TRANSLATOR_BACKEND_SECRET=
TRANSLATOR_BACKEND_SECRET_PREVIOUS=
# The Cloudflare Tunnel's connector token
TUNNEL_TOKEN=
