BACKEND_TAG=latest
FRONTEND_TAG=latest
BACKEND_ADMIN_PORT=8000
FRONTEND_PORT=8091
# signed (default) | trusted-network (backend and frontend share only an internal network)
BACKEND_SURFACE_AUTH=signed
# openssl rand -hex 32 — used as TRANSLATOR_FRONTEND_SECRET on the backend too,
# so registering http://translator-frontend:8080 needs only the address
TRANSLATOR_BACKEND_SECRET=
TRANSLATOR_BACKEND_SECRET_PREVIOUS=
